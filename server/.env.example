# Cartora server environment. Copy to server/.env and fill in values.
# On Render, add the same keys under Environment. Never commit real values.

# --- App ---
NODE_ENV=
PORT=
FRONTEND_URL=

# --- MongoDB Atlas: the full connection string, including the database name (/cartora) ---
MONGO_URL=

# --- Auth ---
JWT_SECRET=

# --- Google OAuth 2.0: one client for Google sign-in and the Gmail API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The Gmail address that sends OTP and order emails
EMAIL_USER=

# --- Stripe (test mode keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
