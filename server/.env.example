# Cartora server environment. Copy to server/.env and fill in values.
# On Render, add the same keys under Environment. Never commit real values.

# --- App ---
NODE_ENV=
PORT=
CLIENT_URL=

# --- MongoDB Atlas (the app builds the connection string from these parts) ---
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DB_NAME=

# --- Auth ---
JWT_SECRET=
OTP_PEPPER=
GOOGLE_SIGNIN_CLIENT_ID=

# --- Gmail API (OAuth 2.0, scope: gmail.send) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# --- Stripe (test mode keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
